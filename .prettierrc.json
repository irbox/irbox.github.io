{
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "plugins": ["/usr/local/lib/node_modules/@shopify/prettier-plugin-liquid/dist/index.js"],
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "liquid-html",
        "singleQuote": false
      }
    }
  ]
}
