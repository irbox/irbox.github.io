{
  "$schema": "https://designtokens.org",
  "meta": {
    "name": "Choroid",
    "version": "3.0.0",
    "note": "Precautionary ergonomic defaults; no randomized long-term myopia trials exist.",
    "protocol": {
      "minDistanceCm": 30,
      "preferredDistanceCm": 40,
      "maxContinuousNearWorkMin": 30,
      "distanceBreakMin": 5,
      "roomIlluminanceLux": "500-1000",
      "screenLuminanceCdM2": "35-86",
      "dailyOutdoorHoursChildren": 2
    }
  },
  "typography": {
    "capHeight34Arcmin": {
      "30cm": { "$value": "16.2px", "$type": "dimension" },
      "40cm": { "$value": "21.6px", "$type": "dimension" },
      "50cm": { "$value": "27.0px", "$type": "dimension" },
      "60cm": { "$value": "32.4px", "$type": "dimension" },
      "70cm": { "$value": "37.8px", "$type": "dimension" }
    },
    "xHeight34Arcmin": {
      "30cm": { "$value": "21.8px", "$type": "dimension" },
      "40cm": { "$value": "29.1px", "$type": "dimension" },
      "50cm": { "$value": "36.4px", "$type": "dimension" },
      "60cm": { "$value": "43.6px", "$type": "dimension" },
      "70cm": { "$value": "50.9px", "$type": "dimension" }
    }
  },
  "modes": {
    "deep": {
      "background": {
        "base": { "$value": "#0A0F14", "$type": "color" },
        "raised": { "$value": "#101820", "$type": "color" },
        "overlay": { "$value": "#17222C", "$type": "color" },
        "highlight": { "$value": "#22313D", "$type": "color" },
        "border": { "$value": "#2C3C49", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "#E9EEF3", "$type": "color" },
        "secondary": { "$value": "#B8C4CF", "$type": "color" },
        "muted": { "$value": "#8C9DAB", "$type": "color" }
      },
      "accent": {
        "red": { "$value": "#F69B96", "$type": "color" },
        "orange": { "$value": "#F3A76A", "$type": "color" },
        "yellow": { "$value": "#F2CC6B", "$type": "color" },
        "green": { "$value": "#8FD694", "$type": "color" },
        "teal": { "$value": "#56D6CA", "$type": "color" },
        "blue": { "$value": "#79BDFF", "$type": "color" },
        "purple": { "$value": "#C2A8F3", "$type": "color" },
        "pink": { "$value": "#F49BC1", "$type": "color" }
      }
    },
    "soft": {
      "background": {
