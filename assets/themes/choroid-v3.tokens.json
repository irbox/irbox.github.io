        "secondary": { "$value": "#B4C1CD", "$type": "color" },
        "muted": { "$value": "#8EA0AF", "$type": "color" }
      },
      "accent": {
        "red": { "$value": "#F79E99", "$type": "color" },
        "orange": { "$value": "#F0AB73", "$type": "color" },
        "yellow": { "$value": "#EBCB75", "$type": "color" },
        "green": { "$value": "#92D298", "$type": "color" },
