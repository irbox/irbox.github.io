{
  "name": "Nature (Choroid v3 Deep)",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#0A0F14",
    "editor.foreground": "#E9EEF3",
    "editorLineNumber.foreground": "#8C9DAB",
    "editorLineNumber.activeForeground": "#F2CC6B",
    "editorCursor.foreground": "#F2CC6B",
    "editor.selectionBackground": "#22313D",
    "editor.lineHighlightBackground": "#101820",
    "editor.findMatchBackground": "#22313D",
    "editor.findMatchBorder": "#F2CC6B",
    "sideBar.background": "#101820",
    "sideBar.foreground": "#B8C4CF",
    "sideBar.border": "#2C3C49",
    "activityBar.background": "#0A0F14",
    "activityBar.foreground": "#E9EEF3",
    "activityBarBadge.background": "#56D6CA",
    "activityBarBadge.foreground": "#0A0F14",
    "statusBar.background": "#101820",
    "statusBar.foreground": "#B8C4CF",
    "statusBar.border": "#2C3C49",
    "panel.background": "#101820",
    "panel.border": "#2C3C49",
    "panelTitle.activeForeground": "#E9EEF3",
    "panelTitle.activeBorder": "#56D6CA",
    "terminal.background": "#0A0F14",
    "terminal.foreground": "#E9EEF3",
    "terminal.ansiBlack": "#17222C",
    "terminal.ansiRed": "#F69B96",
    "terminal.ansiGreen": "#8FD694",
    "terminal.ansiYellow": "#F2CC6B",
    "terminal.ansiBlue": "#79BDFF",
    "terminal.ansiMagenta": "#C2A8F3",
    "terminal.ansiCyan": "#56D6CA",
    "terminal.ansiWhite": "#E9EEF3",
    "editorError.foreground": "#F69B96",
    "editorWarning.foreground": "#F2CC6B",
    "editorInfo.foreground": "#79BDFF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8C9DAB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Body Identifiers (Neutral Cool-White)",
      "scope": ["variable", "identifier", "meta.block", "source"],
      "settings": {
        "foreground": "#E9EEF3"
      }
    },
    {
      "name": "Punctuation & Operators",
      "scope": ["punctuation", "keyword.operator"],
      "settings": {
        "foreground": "#B8C4CF"
      }
    },
    {
      "name": "Functions & Methods (Low-Fatigue Yellow)",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#F2CC6B"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#8FD694"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#79BDFF"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": ["entity.name.type", "entity.name.class", "support.type"],
      "settings": {
        "foreground": "#56D6CA"
      }
    },
    {
      "name": "Constants, Numbers & Booleans",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#C2A8F3"
      }
    },
    {
      "name": "Parameters & Attributes",
      "scope": ["variable.parameter", "entity.other.attribute-name"],
      "settings": {
        "foreground": "#F3A76A"
      }
    },
    {
      "name": "Errors & Invalid Tokens (Red Quarantined)",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {
        "foreground": "#F69B96",
        "fontStyle": "underline"
      }
    }
  ]
}
