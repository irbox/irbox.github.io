{
  "name": "irbox.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Personal showcase, documentation, books archive and web reader",
  "scripts": {
    "build": "make build && node scripts/optimize.js",
    "build:prod": "make build && node scripts/optimize.js",
    "build:clean": "make clean && npm run build",
    "optimize": "node scripts/optimize.js",
    "obfuscate": "node scripts/optimize.js --obfuscate-only",
    "minify": "node scripts/optimize.js --minify-only",
    "index:books": "node scripts/index_books.js",
    "build:epub": "node scripts/build_epub.js",
    "format": "prettier --write .",
    "check": "prettier --check ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "javascript-obfuscator": "^5.9.0",
    "svgo": "^4.1.0",
    "terser": "^5.51.2"
  }
}
