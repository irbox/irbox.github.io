---
layout: null
---
{
  "name": "{{ site.title }} — Showcase, Docs & Engineering Notes",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0C0E12",
  "theme_color": "#FAF8F5",
  "lang": "{{ site.lang }}",
  "dir": "ltr",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    {
      "src": "{{ '/assets/images/favicon.svg' | relative_url }}",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "{{ '/assets/images/brand-icon.svg' | relative_url }}",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "{{ '/assets/images/icon-192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "{{ '/assets/images/icon-512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Documentation",
      "short_name": "Docs",
      "description": "Guides and architecture references",
      "url": "{{ '/docs/getting-started/' | relative_url }}",
      "icons": [
        {
          "src": "{{ '/assets/images/icon-192.png' | relative_url }}",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Selected Projects",
      "short_name": "Projects",
      "description": "Web apps, developer tools and libraries",
      "url": "{{ '/projects/' | relative_url }}",
      "icons": [
        {
          "src": "{{ '/assets/images/icon-192.png' | relative_url }}",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Engineering Blog",
      "short_name": "Blog",
      "description": "Notes and deep-dives on engineering",
      "url": "{{ '/blog/' | relative_url }}",
      "icons": [
        {
          "src": "{{ '/assets/images/icon-192.png' | relative_url }}",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
