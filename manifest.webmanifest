{
  "id": "/",
  "name": "irbox — Showcase, Docs & Engineering Notes",
  "short_name": "irbox",
  "description": "Personal site and digital garden of irbox — projects, technical notes, open-source tools, and documentation.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "orientation": "any",
  "background_color": "#0a0d12",
  "theme_color": "#faf8f5",
  "lang": "en",
  "dir": "ltr",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    {
      "src": "/assets/images/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/images/brand-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/assets/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Documentation",
      "short_name": "Docs",
      "description": "Guides and architecture references",
      "url": "/docs/getting-started/",
      "icons": [
        {
          "src": "/assets/images/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Selected Projects",
      "short_name": "Projects",
      "description": "Web apps, developer tools and libraries",
      "url": "/projects/",
      "icons": [
        {
          "src": "/assets/images/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Engineering Blog",
      "short_name": "Blog",
      "description": "Notes and deep-dives on engineering",
      "url": "/blog/",
      "icons": [
        {
          "src": "/assets/images/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
